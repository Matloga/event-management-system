# The API base URL. Leave as /api to use the Vite dev proxy (recommended).
# For a deployed build, point this at the deployed backend, e.g.
#   VITE_API_URL=https://your-api.onrender.com/api
VITE_API_URL=/api

# Where the dev proxy forwards /api requests during `npm run dev`.
VITE_PROXY_TARGET=http://localhost:5000
