# ---------------------------------------------------------------- app
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (CORS).
CLIENT_URL=http://localhost:5173
# Public origin of the web app, used to build the link encoded into ticket QR
# codes. A phone camera opens that link, so it must be the SPA's /check-in page
# and not the API. Leave blank in development; defaults to the first CLIENT_URL
# entry. Set it when the app and the API are deployed on different hosts.
PUBLIC_CLIENT_URL=

# ------------------------------------------------------- SQL Server
# Local:  DB_SERVER=localhost
# Azure SQL:  DB_SERVER=my-server.database.windows.net  DB_ENCRYPT=true
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=event_management
DB_USER=sa
DB_PASSWORD=
# Set to true for Azure SQL. For a local dev instance with a self-signed
# certificate, keep encrypt=true and add DB_TRUST_CERT=true.
DB_ENCRYPT=true
DB_TRUST_CERT=true
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=15000
# Separate database used by `npm test`. Leave blank to skip integration tests.
DB_TEST_NAME=event_management_test

# ------------------------------------------------------------- auth
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ------------------------------------------------------------- mail
# console = print a one-line summary (default)
# json    = render the full message to stdout as JSON
# smtp    = send for real
MAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@events.local
MAIL_FROM_NAME=Event Management System
